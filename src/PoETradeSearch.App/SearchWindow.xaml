<Window x:Class="PoETradeSearch.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PoETradeSearch.App"
        Title="거래소 검색" Width="640" Height="860" MinWidth="520" MinHeight="500"
        Icon="/Assets/app.ico"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow -->
    <Border Margin="10" CornerRadius="12" Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.7" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MaxHeight="320" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: item name in rarity colour; drag to move -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{StaticResource Panel}" Padding="18,14,10,12"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" FontSize="14"
                            VerticalAlignment="Top" Click="CloseButton_Click" ToolTip="닫기 (Esc)" />
                    <Image DockPanel.Dock="Left" Source="/Assets/app.png" Width="34" Height="34" Margin="0,2,12,0"
                           VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ItemNameText" FontSize="19" FontWeight="SemiBold" />
                            <Border x:Name="RarityBadge" CornerRadius="8" Padding="7,1" Margin="10,2,0,0"
                                    VerticalAlignment="Center" BorderThickness="1">
                                <TextBlock x:Name="RarityBadgeText" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ItemInfoText" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                        <TextBlock x:Name="UniqueHintText" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="고유 아이템은 이름과 베이스로 검색합니다. 옵션을 체크하면 그 수치 이상으로 굴린 것만 찾습니다." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Item conditions -->
            <!-- Conditions: one labelled row per group so they don't run together -->
            <Grid Grid.Row="1" Margin="18,14,18,2">
                <Grid.Resources>
                    <Style x:Key="RowLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Margin" Value="0,5,0,0" />
                    </Style>
                    <Style x:Key="SubLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Item -->
                <TextBlock Grid.Row="0" Text="아이템" Style="{StaticResource RowLabel}" />
                <WrapPanel Grid.Row="0" Grid.Column="1">
                    <ToggleButton x:Name="BaseTypeChip" Style="{StaticResource Chip}" />
                    <ToggleButton x:Name="FracturedChip" Style="{StaticResource Chip}" Content="분열 아이템만"
                                  ToolTip="켜면 분열 아이템만, 끄면 같은 옵션이 붙은 일반 아이템도 찾습니다"
                                  Checked="FracturedChip_Changed" Unchecked="FracturedChip_Changed" />
                    <ToggleButton x:Name="SynthesisedChip" Style="{StaticResource Chip}" Content="합성 아이템" />
                    <ToggleButton x:Name="SearingChip" Style="{StaticResource Chip}" Content="서칭 엑자크" />
                    <ToggleButton x:Name="TangledChip" Style="{StaticResource Chip}" Content="이터 오브 월드" />
                    <WrapPanel x:Name="InfluenceChips" />
                </WrapPanel>

                <!-- Trade mode: which listings are searched -->
                <TextBlock Grid.Row="1" Text="거래" Style="{StaticResource RowLabel}" />
                <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{StaticResource Border}" Background="{StaticResource Panel}" Padding="2" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeBoth" Style="{StaticResource Segment}" GroupName="Mode" Content="즉시 구매 + 직접 거래" IsChecked="True"
                                     ToolTip="상인 탭 즉시 구매와 온라인 판매자 직접 거래 매물을 모두 검색합니다" />
                        <RadioButton x:Name="ModeInstant" Style="{StaticResource Segment}" GroupName="Mode" Content="즉시 구매만"
                                     ToolTip="판매자가 없어도 바로 살 수 있는 상인 탭 매물만" />
                        <RadioButton x:Name="ModeInPerson" Style="{StaticResource Segment}" GroupName="Mode" Content="직접 거래만"
                                     ToolTip="지금 온라인인 판매자와 직접 거래하는 매물만" />
                        <RadioButton x:Name="ModeAny" Style="{StaticResource Segment}" GroupName="Mode" Content="오프라인 포함"
                                     ToolTip="오프라인 판매자 매물까지 모두" />
                    </StackPanel>
                </Border>

                <!-- Corrupted -->
                <TextBlock Grid.Row="2" Text="타락" Style="{StaticResource RowLabel}" />
                <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{StaticResource Border}" Background="{StaticResource Panel}" Padding="2" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="CorruptedAny" Style="{StaticResource Segment}" GroupName="Corrupted" Content="상관없음" />
                        <RadioButton x:Name="CorruptedOnly" Style="{StaticResource Segment}" GroupName="Corrupted" Content="타락만" />
                        <RadioButton x:Name="CorruptedNo" Style="{StaticResource Segment}" GroupName="Corrupted" Content="타락 제외" />
                    </StackPanel>
                </Border>

                <!-- Numbers: item level, gem level, quality -->
                <TextBlock Grid.Row="3" x:Name="NumbersCaption" Text="수치" Style="{StaticResource RowLabel}" />
                <WrapPanel Grid.Row="3" Grid.Column="1" x:Name="NumbersPanel">
                    <StackPanel x:Name="ItemLevelPanel" Orientation="Horizontal" Margin="0,0,14,6">
                        <ToggleButton x:Name="ItemLevelChip" Style="{StaticResource Chip}" Margin="0" Content="아이템 레벨 최소" />
                        <TextBox x:Name="ItemLevelText" Width="50" Margin="4,0,0,0"
                                 IsEnabled="{Binding IsChecked, ElementName=ItemLevelChip}" />
                    </StackPanel>
                    <StackPanel x:Name="GemLevelPanel" Orientation="Horizontal" Margin="0,0,14,6">
                        <ToggleButton x:Name="GemLevelChip" Style="{StaticResource Chip}" Margin="0" Content="젬 레벨" />
                        <TextBox x:Name="GemLevelMinText" Width="50" Margin="4,0,0,0" ToolTip="최소 (비우면 제한 없음)"
                                 IsEnabled="{Binding IsChecked, ElementName=GemLevelChip}" />
                        <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                        <TextBox x:Name="GemLevelMaxText" Width="50" ToolTip="최대 (비우면 제한 없음)"
                                 IsEnabled="{Binding IsChecked, ElementName=GemLevelChip}" />
                    </StackPanel>
                    <StackPanel x:Name="QualityPanel" Orientation="Horizontal" Margin="0,0,14,6">
                        <ToggleButton x:Name="QualityChip" Style="{StaticResource Chip}" Margin="0" Content="퀄리티" />
                        <TextBox x:Name="QualityMinText" Width="50" Margin="4,0,0,0" ToolTip="최소 (비우면 제한 없음)"
                                 IsEnabled="{Binding IsChecked, ElementName=QualityChip}" />
                        <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                        <TextBox x:Name="QualityMaxText" Width="50" ToolTip="최대 (비우면 제한 없음)"
                                 IsEnabled="{Binding IsChecked, ElementName=QualityChip}" />
                    </StackPanel>
                </WrapPanel>

                <!-- Sockets: total | colours | links, clearly separated -->
                <TextBlock Grid.Row="4" x:Name="SocketsCaption" Text="홈" Style="{StaticResource RowLabel}" />
                <WrapPanel Grid.Row="4" Grid.Column="1" x:Name="SocketsRow">
                    <StackPanel x:Name="SocketsPanel" Orientation="Horizontal" Margin="0,0,14,6">
                        <StackPanel.Resources>
                            <!-- Small fixed-height boxes so a single digit is never clipped -->
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Height" Value="26" />
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </StackPanel.Resources>
                        <ToggleButton x:Name="SocketsChip" Style="{StaticResource Chip}" Margin="0,0,10,0" Content="홈 조건" VerticalAlignment="Center"
                                      ToolTip="홈 개수와 색상별 최소 개수 (비운 칸은 제한 없음)" />
                        <TextBlock Text="총" Style="{StaticResource SubLabel}" />
                        <TextBox x:Name="SocketCountText" Width="40" ToolTip="홈 개수 최소"
                                 IsEnabled="{Binding IsChecked, ElementName=SocketsChip}" />
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderStrong}" Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock Text="색상" Style="{StaticResource SubLabel}" />
                        <Border CornerRadius="10" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#D24A3C" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="SocketRedText" Width="36" Margin="0,0,10,0" ToolTip="빨강 최소"
                                         IsEnabled="{Binding IsChecked, ElementName=SocketsChip}" />
                                <Ellipse Width="10" Height="10" Fill="#5BBE4E" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="SocketGreenText" Width="36" Margin="0,0,10,0" ToolTip="초록 최소"
                                         IsEnabled="{Binding IsChecked, ElementName=SocketsChip}" />
                                <Ellipse Width="10" Height="10" Fill="#4C7BE0" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="SocketBlueText" Width="36" Margin="0,0,10,0" ToolTip="파랑 최소"
                                         IsEnabled="{Binding IsChecked, ElementName=SocketsChip}" />
                                <Ellipse Width="10" Height="10" Fill="#EDEDED" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="SocketWhiteText" Width="36" ToolTip="흰색 최소"
                                         IsEnabled="{Binding IsChecked, ElementName=SocketsChip}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="LinksPanel" Orientation="Horizontal" Margin="0,0,14,6">
                        <ToggleButton x:Name="LinksChip" Style="{StaticResource Chip}" Margin="0" Content="링크 최소" />
                        <TextBox x:Name="LinksText" Width="40" Margin="4,0,0,0"
                                 IsEnabled="{Binding IsChecked, ElementName=LinksChip}" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
            <!-- Mods -->
            <DockPanel Grid.Row="2" Margin="18,8,18,0" x:Name="ModsSection">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="최소  ~  최대" Foreground="{StaticResource TextFaint}"
                               FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="옵션" Style="{StaticResource Caption}" Margin="0" />
                </DockPanel>
                <Border CornerRadius="8" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                        <ItemsControl x:Name="ModsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ModFilterRow}">
                                    <Border x:Name="Row" Padding="10,5" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" IsEnabled="{Binding IsMatched}"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <WrapPanel>
                                                    <Border CornerRadius="4" Background="#2A2540" Padding="5,0" Margin="0,1,6,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding ShowTag, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10.5" Foreground="{StaticResource ModCrafted}" />
                                                    </Border>
                                                    <!-- Fractured mods: click to switch between "fractured only" and "any" -->
                                                    <ToggleButton Style="{StaticResource Chip}" Margin="0,0,6,0" Padding="7,0" FontSize="10.5"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding SearchAsFractured}" Content="{Binding FractureToggleText}"
                                                                  ToolTip="켜면 이 옵션이 분열된 것만, 끄면 분열 여부와 상관없이 찾습니다"
                                                                  Visibility="{Binding IsFracturedMod, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock x:Name="ModText" Text="{Binding Text}" Foreground="{Binding TextColor}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource TextMuted}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                        Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}">
                                                <TextBox Width="58" Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding Enabled}" ToolTip="최소값 (비우면 제한 없음)" />
                                                <TextBlock Text="~" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                                                <TextBox Width="58" Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding Enabled}" ToolTip="최대값 (비우면 제한 없음)" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaised}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                            <Setter TargetName="ModText" Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- Actions -->
            <DockPanel Grid.Row="3" Margin="18,12,18,10">
                <Button x:Name="SearchButton" Style="{StaticResource PrimaryButton}" Content="검색  ⏎"
                        Click="SearchButton_Click" IsDefault="True" />
                <Button x:Name="OpenWebButton" Content="브라우저로 열기" Margin="8,0,0,0" Click="OpenWebButton_Click" IsEnabled="False" />
                <TextBlock x:Name="SearchStatusText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}" FontSize="12" />
            </DockPanel>

            <!-- Results, cheapest first -->
            <Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,10,14,6">
                    <StackPanel>
                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ListingView}">
                                    <Border x:Name="Card" CornerRadius="8" Background="{StaticResource Panel}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Price block -->
                                            <Border Grid.Column="0" CornerRadius="8,0,0,8" Background="{StaticResource PanelRaised}"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="8,12">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="{Binding PriceIcon}" Width="32" Height="32" Margin="0,0,0,2"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Text="{Binding PriceAmount}" FontSize="22" FontWeight="Bold"
                                                               Foreground="{StaticResource Price}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding PriceCurrency}" Foreground="{StaticResource Price}" FontSize="11.5"
                                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Rank, StringFormat=#{0}}" Foreground="{StaticResource TextFaint}"
                                                               FontSize="10.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Item -->
                                            <StackPanel Grid.Column="1" Margin="14,10,12,10">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource GoldBright}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding TopMods}" Margin="0,8,0,0"
                                                              Visibility="{Binding HasTopMods, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:ModLineView}">
                                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Rectangle Height="1" Fill="{StaticResource Border}" Margin="0,6"
                                                           Visibility="{Binding HasTopMods, Converter={StaticResource BoolToVis}}" />
                                                <ItemsControl ItemsSource="{Binding MainMods}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:ModLineView}">
                                                            <WrapPanel Margin="0,0,0,1">
                                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                                                                <Border CornerRadius="4" Background="#2A2540" Padding="5,0" Margin="6,1,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="{StaticResource ModCrafted}" />
                                                                </Border>
                                                            </WrapPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="타락" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,4,0,0"
                                                           Visibility="{Binding IsCorrupted, Converter={StaticResource BoolToVis}}" />

                                                <!-- Seller -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding OnlineColor}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SellerName}" Foreground="{StaticResource Text}" FontSize="11.5" />
                                                    <TextBlock Text="{Binding ListedAgo, StringFormat=  ·  {0}}" Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="MoreButton" Content="10개 더 보기" HorizontalAlignment="Center" Margin="0,2,0,10"
                                Click="MoreButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
