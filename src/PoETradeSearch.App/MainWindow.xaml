<Window x:Class="PoETradeSearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE Trade Search" Height="640" Width="680" MinWidth="520" MinHeight="420"
        Icon="/Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel Margin="16">
        <!-- Status -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="6" Background="#3A2F18" BorderBrush="{StaticResource Gold}"
                        BorderThickness="1" Padding="12,6" VerticalAlignment="Top">
                    <TextBlock x:Name="HotkeyText" Text="Ctrl+D" FontWeight="SemiBold" Foreground="{StaticResource GoldBright}" FontSize="15" />
                </Border>
                <Image DockPanel.Dock="Left" Source="/Assets/app.png" Width="48" Height="48" Margin="0,0,14,0"
                       VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="PoE Trade Search" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,0,3" />
                    <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" Text="준비 중..." TextWrapping="Wrap" />
                    <TextBlock x:Name="HintText" Margin="0,6,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shown when PoE runs as administrator and this app doesn't: Windows then blocks our Ctrl+C -->
        <Border DockPanel.Dock="Top" x:Name="ElevationPanel" Visibility="Collapsed" Margin="0,10,0,0"
                CornerRadius="10" Background="#2A1614" BorderBrush="{StaticResource Danger}" BorderThickness="1" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="관리자 권한으로 다시 실행" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Margin="12,0,0,0" Click="RunAsAdminButton_Click" />
                <StackPanel>
                    <TextBlock Text="게임이 관리자 권한으로 실행 중입니다" FontWeight="SemiBold" Foreground="#F08A84" />
                    <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                               Text="이 경우 Windows가 일반 프로그램의 키 입력을 막아서 Ctrl+C가 게임에 전달되지 않습니다. 이 프로그램도 관리자 권한으로 실행해야 합니다." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Settings -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="설정" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="서버" VerticalAlignment="Center" Width="34" Foreground="{StaticResource TextMuted}" />
                    <ComboBox x:Name="ServerCombo" Width="240" SelectionChanged="ServerCombo_SelectionChanged" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" FontSize="12"
                               Text="한글 아이템은 카카오, 영문 아이템은 글로벌로 자동 전환" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="리그" VerticalAlignment="Center" Width="34" Foreground="{StaticResource TextMuted}" />
                    <ComboBox x:Name="LeagueCombo" Width="240" DisplayMemberPath="Text"
                              SelectionChanged="LeagueCombo_SelectionChanged" />
                    <TextBlock x:Name="LeagueStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox x:Name="OnlyInGameCheck" IsChecked="True" Margin="0,12,0,0"
                          Content="PoE 창이 앞에 있을 때만 단축키 동작" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse x:Name="StatsDot" Width="7" Height="7" Fill="{StaticResource TextFaint}" Margin="0,1,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatsText" Foreground="{StaticResource TextMuted}" FontSize="12"
                               Text="거래소 stat 데이터 불러오는 중..." TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Debug -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,8">
            <Button x:Name="CopyDiagnosticsButton" Content="진단 정보 복사" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,6,6" Click="CopyDiagnosticsButton_Click"
                    ToolTip="최근 로그와 환경 정보를 클립보드에 복사합니다. 문제가 생기면 이걸 붙여서 보내주세요." />
            <Button Content="로그 폴더 열기" Margin="0,0,6,6" Click="OpenLogFolderButton_Click" />
            <Button x:Name="ParseClipboardButton" Content="현재 클립보드 파싱 (테스트용)" Margin="0,0,6,6"
                    Click="ParseClipboardButton_Click" />
            <Button x:Name="CopyOutputButton" Content="아이템 결과 복사" Margin="0,0,6,6" Click="CopyOutputButton_Click" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="마지막으로 읽은 아이템" Style="{StaticResource Caption}" />
        <TextBox x:Name="OutputText" IsReadOnly="True" FontFamily="Consolas, Malgun Gothic" FontSize="12"
                 Background="{StaticResource Panel}" Foreground="{StaticResource TextMuted}"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="10,8"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</Window>
