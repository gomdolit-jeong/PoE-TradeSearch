<Window x:Class="PoETradeSearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE Trade Search" Height="560" Width="640"
        Background="#1E1E1E" Foreground="#DDDDDD" FontFamily="Malgun Gothic, Segoe UI">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" Text="준비 중..." />
            <TextBlock x:Name="HintText" Margin="0,4,0,0" Foreground="#999999" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="OnlyInGameCheck" IsChecked="True" Foreground="#DDDDDD"
                          VerticalAlignment="Center" Content="PoE 창이 앞에 있을 때만 동작" />
                <Button x:Name="ParseClipboardButton" Margin="16,0,0,0" Padding="10,3"
                        Content="현재 클립보드 파싱 (테스트용)" Click="ParseClipboardButton_Click" />
                <Button x:Name="CopyOutputButton" Margin="8,0,0,0" Padding="10,3"
                        Content="결과 복사 (버그 제보용)" Click="CopyOutputButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatsText" Margin="0,6,0,0" Foreground="#999999" Text="거래소 stat 데이터 불러오는 중..." />
        </StackPanel>
        <TextBox x:Name="OutputText" IsReadOnly="True" FontFamily="Consolas, Malgun Gothic"
                 Background="#111111" Foreground="#DDDDDD" BorderBrush="#333333"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />
    </DockPanel>
</Window>
