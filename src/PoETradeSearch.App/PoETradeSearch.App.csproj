<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PoETradeSearch.Core\PoETradeSearch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window title bar icon and the logo shown inside the windows. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Output is PoETradeSearch.exe (the project folder keeps its .App name). -->
    <AssemblyName>PoETradeSearch</AssemblyName>
    <!-- exe / taskbar icon. Regenerate with tools\make-icon.ps1. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- File properties shown by Windows (an exe without them looks more suspicious to SmartScreen/antivirus). -->
    <Version>0.5.0</Version>
    <Product>PoE Trade Search</Product>
    <AssemblyTitle>PoE Trade Search</AssemblyTitle>
    <Description>Path of Exile 거래소 시세 검색 도구</Description>
    <Copyright>MIT License</Copyright>

    <!-- Single-file publish settings (see README). Compression is off: compressed self-extracting exes are
         flagged by antivirus heuristics more often. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
