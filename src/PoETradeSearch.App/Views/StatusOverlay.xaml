<Window x:Class="PoETradeSearch.App.Views.StatusOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE 검색기 실행 중" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource UiFont}" FontSize="11">
    <!-- Small badge, top centre of the screen by default. Clicks pass through it to the game, except in move mode
         (설정 → "위치 옮기기"), where it can be dragged. DataContext: ViewModels.MainViewModel -->
    <Border x:Name="Badge" CornerRadius="0,0,8,8" Background="#CC16130F" BorderBrush="{StaticResource BorderStrong}"
            BorderThickness="1,0,1,1" Padding="10,2,10,3" MouseLeftButtonDown="Badge_MouseLeftButtonDown">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Online}" VerticalAlignment="Center" Margin="0,1,6,0" />
                <TextBlock Text="{Binding OverlayText}" Foreground="{StaticResource GoldBright}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MoveHint" Visibility="Collapsed" Margin="0,3,0,1" Foreground="{StaticResource Text}"
                       Text="끌어서 옮기세요 · 놓으면 그 자리에 고정" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
