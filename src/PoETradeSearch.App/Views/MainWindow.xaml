<Window x:Class="PoETradeSearch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PoETradeSearch.App.Converters"
        Title="PoE Trade Search" Width="640" SizeToContent="Height" ResizeMode="CanMinimize"
        Icon="/Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Window.Resources>

    <!-- DataContext: ViewModels.MainViewModel -->
    <StackPanel x:Name="RootPanel" Margin="16">
        <!-- Status -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/Assets/app.png" Width="48" Height="48" Margin="0,0,14,0"
                       VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="PoE Trade Search" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gold}" />
                        <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Text="게임에서 아이템에 마우스를 올리고 단축키를 누르면 검색 창이 뜹니다. 검색 창에서 조건을 바꾸고 Enter로 다시 검색, Esc로 닫습니다." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- New version on GitHub: one click downloads it, swaps the exe and restarts -->
        <Border Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0"
                CornerRadius="10" Background="#231E12" BorderBrush="{StaticResource GoldBright}" BorderThickness="1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="변경 내용" Padding="10,4" Margin="0,0,8,0" Command="{Binding OpenReleasePageCommand}" />
                    <Button Content="{Binding UpdateButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateText}" FontWeight="SemiBold" Foreground="{StaticResource GoldBright}" />
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="누르면 새 버전을 받아서 바꾼 뒤 다시 시작합니다. 설정은 그대로 남습니다." />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="4,6,0,0"
                   TextWrapping="Wrap" Visibility="{Binding UpdateStatus, Converter={StaticResource NotEmptyToVis}}" />

        <!-- Shown when PoE runs as administrator and this app doesn't: Windows then blocks our key presses -->
        <Border Visibility="{Binding ShowElevationWarning, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0"
                CornerRadius="10" Background="#2A1614" BorderBrush="{StaticResource Danger}" BorderThickness="1" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="관리자 권한으로 다시 실행" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding RunAsAdminCommand}" />
                <StackPanel>
                    <TextBlock Text="게임이 관리자 권한으로 실행 중입니다" FontWeight="SemiBold" Foreground="#F08A84" />
                    <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"
                               Text="이 경우 Windows가 일반 프로그램의 키 입력을 막아서 아이템 복사가 되지 않습니다. 이 프로그램도 관리자 권한으로 실행해야 합니다." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Settings -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
            <Grid>
                <Grid.Resources>
                    <!-- Same bottom margin as the control next to it, so label and control share one centre line -->
                    <Style x:Key="SettingLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                    <Style x:Key="SettingHint" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Margin" Value="10,0,0,0" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="설정" Style="{StaticResource Caption}" />

                <!-- Hotkey: click the box and press the combination (key capture is handled by the window) -->
                <TextBlock Grid.Row="1" Text="단축키" Style="{StaticResource SettingLabel}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="HotkeyBox" Width="160" IsReadOnly="True" FontWeight="SemiBold" Cursor="Hand"
                             Foreground="{StaticResource GoldBright}" IsReadOnlyCaretVisible="False"
                             ToolTip="클릭한 뒤 원하는 키 조합을 누르세요 (예: Ctrl+D, Alt+Q, F2)"
                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <Button Content="기본값" Margin="8,0,0,0" Padding="10,4" Click="HotkeyResetButton_Click" />
                    <TextBlock x:Name="HotkeyHintText" Style="{StaticResource SettingHint}" Text="클릭 후 키 조합 입력" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="서버" Style="{StaticResource SettingLabel}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox Width="240" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="아이템 언어에 맞춰 자동 전환" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="리그" Style="{StaticResource SettingLabel}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox Width="240" ItemsSource="{Binding Leagues}" SelectedItem="{Binding SelectedLeague}"
                              DisplayMemberPath="Text" MaxDropDownHeight="360" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="{Binding LeagueStatus}" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Text/window scale for large or high-resolution screens -->
                <TextBlock Grid.Row="4" Text="화면 크기" Style="{StaticResource SettingLabel}" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox Width="100" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="검색 창의 글자와 창 크기" />
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="1">
                    <CheckBox Content="PoE 창이 앞에 있을 때만 단축키 동작" IsChecked="{Binding OnlyInGame}" />
                    <CheckBox Content="게임을 종료하면 이 프로그램도 같이 종료" Margin="0,8,0,0" IsChecked="{Binding ExitWithGame}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="화면에 실행 중 표시" IsChecked="{Binding ShowOverlay}" VerticalAlignment="Center" />
                        <!-- Move mode: the badge can be dragged once, then it is click-through again -->
                        <Button Content="위치 옮기기" Margin="12,0,0,0" Padding="8,2" FontSize="12.5" Click="MoveOverlayButton_Click"
                                ToolTip="누른 뒤 표시를 끌어서 원하는 곳에 놓으세요"
                                IsEnabled="{Binding ShowOverlay}" />
                        <Button Content="기본 위치" Margin="6,0,0,0" Padding="8,2" FontSize="12.5" Click="ResetOverlayButton_Click"
                                ToolTip="화면 맨 위 가운데로 되돌립니다" IsEnabled="{Binding ShowOverlay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatsBrush}" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatsText}" Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataNote}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="15,4,0,0"
                               TextWrapping="Wrap" Visibility="{Binding HasDataNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
