<Window x:Class="PoETradeSearch.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PoETradeSearch.App.ViewModels"
        xmlns:conv="clr-namespace:PoETradeSearch.App.Converters"
        Title="거래소 검색" Width="480" Height="740" MinWidth="440" MinHeight="400"
        Icon="/Assets/app.ico"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource Text}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumIsConverter x:Key="EnumIs" />
        <conv:InverseBoolConverter x:Key="Not" />
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow -->
    <Border x:Name="RootBorder" Margin="10" CornerRadius="12" Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.7" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: item name in rarity colour; drag to move -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{StaticResource Panel}" Padding="14,9,8,8"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" FontSize="14"
                            VerticalAlignment="Top" Click="CloseButton_Click" ToolTip="닫기 (Esc)" />
                    <Image DockPanel.Dock="Left" Source="/Assets/app.png" Width="24" Height="24" Margin="0,1,9,0"
                           VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ItemName}" Foreground="{Binding RarityBrush}" ToolTip="{Binding NameTooltip}"
                                       FontSize="15" FontWeight="SemiBold" />
                            <Border CornerRadius="8" Padding="7,1" Margin="8,1,0,0" BorderBrush="{Binding RarityBrush}"
                                    VerticalAlignment="Center" BorderThickness="1">
                                <TextBlock Text="{Binding RarityText}" Foreground="{Binding RarityBrush}" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ItemInfo}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ItemInfo}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Item conditions -->
            <!-- Conditions: one labelled row per group so they don't run together -->
            <Grid Grid.Row="1" Margin="14,8,14,0">
                <Grid.Resources>
                    <Style x:Key="RowLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Margin" Value="0,3,0,0" />
                    </Style>
                    <!-- Compact number boxes in the condition rows -->
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="2,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="SubLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Item -->
                <TextBlock Grid.Row="0" Text="아이템" Style="{StaticResource RowLabel}" />
                <WrapPanel Grid.Row="0" Grid.Column="1">
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding BaseTypeLabel}"
                                  IsChecked="{Binding UseBaseType}" IsEnabled="{Binding CanChangeBaseType}" />
                    <!-- Item flags from game-data.json (분열, 결합, 작열의 총주교, ...), influences and the Foulborn filter -->
                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChipViewModel}">
                                <ToggleButton Style="{StaticResource Chip}" Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked}" ToolTip="{Binding Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <!-- Trade mode: which listings are searched -->
                <TextBlock Grid.Row="1" Text="거래" Style="{StaticResource RowLabel}" />
                <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{StaticResource Border}" Background="{StaticResource Panel}" Padding="1" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="즉시+직접"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumIs}, ConverterParameter=InstantAndInPerson}"
                                     ToolTip="상인 탭 즉시 구매와 온라인 판매자 직접 거래 매물을 모두 검색합니다" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="즉시 구매만"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumIs}, ConverterParameter=InstantOnly}"
                                     ToolTip="판매자가 없어도 바로 살 수 있는 상인 탭 매물만" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="직접 거래만"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumIs}, ConverterParameter=InPersonOnly}"
                                     ToolTip="지금 온라인인 판매자와 직접 거래하는 매물만" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="오프라인 포함"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumIs}, ConverterParameter=Any}"
                                     ToolTip="오프라인 판매자 매물까지 모두" />
                    </StackPanel>
                </Border>

                <!-- Corrupted -->
                <TextBlock Grid.Row="2" Text="타락" Style="{StaticResource RowLabel}" />
                <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{StaticResource Border}" Background="{StaticResource Panel}" Padding="1" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Corrupted" Content="상관없음"
                                     IsChecked="{Binding Corrupted, Converter={StaticResource EnumIs}, ConverterParameter=Any}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Corrupted" Content="타락만"
                                     IsChecked="{Binding Corrupted, Converter={StaticResource EnumIs}, ConverterParameter=Yes}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Corrupted" Content="타락 제외"
                                     IsChecked="{Binding Corrupted, Converter={StaticResource EnumIs}, ConverterParameter=No}" />
                    </StackPanel>
                </Border>

                <!-- Numbers: item level, gem level, quality -->
                <TextBlock Grid.Row="3" Text="수치" Style="{StaticResource RowLabel}" Margin="0,4,0,0"
                           Visibility="{Binding ShowNumbers, Converter={StaticResource BoolToVis}}" />
                <WrapPanel Grid.Row="3" Grid.Column="1" Visibility="{Binding ShowNumbers, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding ShowItemLevel, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource Chip}" Margin="0" Content="아이템 레벨 최소" IsChecked="{Binding ItemLevelOn}" />
                        <TextBox Width="50" Margin="4,0,0,0" Text="{Binding ItemLevelText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding ItemLevelOn}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding ShowGemLevel, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource Chip}" Margin="0" Content="젬 레벨" IsChecked="{Binding GemLevelOn}" />
                        <TextBox Width="50" Margin="4,0,0,0" ToolTip="최소 (비우면 제한 없음)"
                                 Text="{Binding GemLevelMinText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding GemLevelOn}" />
                        <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                        <TextBox Width="50" ToolTip="최대 (비우면 제한 없음)"
                                 Text="{Binding GemLevelMaxText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding GemLevelOn}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding ShowQuality, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource Chip}" Margin="0" Content="퀄리티" IsChecked="{Binding QualityOn}" />
                        <TextBox Width="50" Margin="4,0,0,0" ToolTip="최소 (비우면 제한 없음)"
                                 Text="{Binding QualityMinText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding QualityOn}" />
                        <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                        <TextBox Width="50" ToolTip="최대 (비우면 제한 없음)"
                                 Text="{Binding QualityMaxText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding QualityOn}" />
                    </StackPanel>
                </WrapPanel>

                <!-- Sockets: total | colours | links, clearly separated -->
                <TextBlock Grid.Row="4" Text="홈" Style="{StaticResource RowLabel}" Margin="0,5,0,0"
                           Visibility="{Binding ShowSocketRow, Converter={StaticResource BoolToVis}}" />
                <WrapPanel Grid.Row="4" Grid.Column="1" Visibility="{Binding ShowSocketRow, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding ShowSockets, Converter={StaticResource BoolToVis}}">
                        <StackPanel.Resources>
                            <!-- Small fixed-height boxes so a single digit is never clipped -->
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Height" Value="22" />
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </StackPanel.Resources>
                        <!-- 상관없음 = no socket filter; 지정 = count/colour boxes below (empty box = no limit) -->
                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Border}"
                                Background="{StaticResource Panel}" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sockets" Content="상관없음"
                                             IsChecked="{Binding SocketsOn, Converter={StaticResource Not}}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sockets" Content="지정"
                                             IsChecked="{Binding SocketsOn}"
                                             ToolTip="홈 개수와 색상별 최소 개수 (비운 칸은 제한 없음)" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="총" Style="{StaticResource SubLabel}" />
                        <TextBox Text="{Binding SocketCountText, UpdateSourceTrigger=PropertyChanged}" Width="28" ToolTip="홈 개수 최소"
                                 IsEnabled="{Binding SocketsOn}" />
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderStrong}" Margin="6,0" VerticalAlignment="Center" />
                        <!-- colour boxes: red, green, blue, white -->
                        <Border CornerRadius="10" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#D24A3C" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBox Text="{Binding SocketRedText, UpdateSourceTrigger=PropertyChanged}" Width="24" Margin="0,0,4,0" ToolTip="빨강 최소"
                                         IsEnabled="{Binding SocketsOn}" />
                                <Ellipse Width="9" Height="9" Fill="#5BBE4E" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBox Text="{Binding SocketGreenText, UpdateSourceTrigger=PropertyChanged}" Width="24" Margin="0,0,4,0" ToolTip="초록 최소"
                                         IsEnabled="{Binding SocketsOn}" />
                                <Ellipse Width="9" Height="9" Fill="#4C7BE0" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBox Text="{Binding SocketBlueText, UpdateSourceTrigger=PropertyChanged}" Width="24" Margin="0,0,4,0" ToolTip="파랑 최소"
                                         IsEnabled="{Binding SocketsOn}" />
                                <Ellipse Width="9" Height="9" Fill="#EDEDED" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBox Text="{Binding SocketWhiteText, UpdateSourceTrigger=PropertyChanged}" Width="24" ToolTip="흰색 최소"
                                         IsEnabled="{Binding SocketsOn}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding ShowLinks, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource Chip}" Margin="0" Content="링크 최소" IsChecked="{Binding LinksOn}" />
                        <TextBox Width="40" Margin="4,0,0,0" Text="{Binding LinksText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding LinksOn}" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
            <!-- Mods -->
            <DockPanel Grid.Row="2" Margin="14,4,14,0" Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="최소  ~  최대" Foreground="{StaticResource TextFaint}"
                               FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="옵션" Style="{StaticResource Caption}" Margin="0" />
                </DockPanel>
                <Border CornerRadius="8" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,3" MaxHeight="170">
                        <ItemsControl ItemsSource="{Binding Mods}" FontSize="11.5">
                            <ItemsControl.Resources>
                                <!-- Compact value boxes -->
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Height" Value="22" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Padding" Value="2,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModFilterRow}">
                                    <StackPanel>
                                    <!-- Line between the fixed (implicit/enchant) mods and the item's own mods -->
                                    <Border Height="1" Margin="8,2" Background="{StaticResource Border}"
                                            Visibility="{Binding StartsNewGroup, Converter={StaticResource BoolToVis}}" />
                                    <Border x:Name="Row" Padding="8,2" Background="Transparent">
                                        <!-- Every part is top-aligned on the first line (22 px = value box height):
                                             checkbox, tag and mod text are centred on that line even when the text wraps. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" IsEnabled="{Binding IsMatched}"
                                                      VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                <DockPanel MinHeight="22">
                                                    <Border DockPanel.Dock="Left" CornerRadius="4" Background="#2A2540" Padding="5,0" Margin="0,4,6,0"
                                                            VerticalAlignment="Top"
                                                            Visibility="{Binding ShowTag, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="{StaticResource ModCrafted}" />
                                                    </Border>
                                                    <!-- Fractured mods: click to switch between "fractured only" and "any" -->
                                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="0,2,6,0" Padding="7,0" FontSize="10.5"
                                                                  VerticalAlignment="Top"
                                                                  IsChecked="{Binding SearchAsFractured}" Content="{Binding FractureToggleText}"
                                                                  ToolTip="켜면 이 옵션이 분열된 것만, 끄면 분열 여부와 상관없이 찾습니다"
                                                                  Visibility="{Binding IsFracturedMod, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock x:Name="ModText" Text="{Binding Text}" Foreground="{Binding TextColor}"
                                                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,3,0,2" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource TextMuted}" FontSize="10"
                                                           Margin="0,0,0,2" TextWrapping="Wrap"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                        Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}">
                                                <TextBox Width="40" Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding Enabled}" ToolTip="최소값 (비우면 제한 없음)" />
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                                                <TextBox Width="40" Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding Enabled}" ToolTip="최대값 (비우면 제한 없음)" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaised}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                            <Setter TargetName="ModText" Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- Actions -->
            <!-- Status sits on its own line under the buttons, so a long hint can wrap without squeezing them -->
            <StackPanel Grid.Row="3" Margin="14,8,14,8">
            <DockPanel>
                <!-- Result order; switching searches again -->
                <Border DockPanel.Dock="Right" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Border}"
                        Background="{StaticResource Panel}" Padding="2" VerticalAlignment="Center" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="가격순"
                                     IsChecked="{Binding NewestFirst, Converter={StaticResource Not}}" ToolTip="가격 낮은 순" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="최신순"
                                     IsChecked="{Binding NewestFirst}" ToolTip="최근에 올린 순" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="검색 ⏎" Padding="12,3" FontSize="11.5"
                            Command="{Binding SearchCommand}" IsDefault="True" />
                    <Button Content="브라우저로 열기" Margin="6,0,0,0" Padding="10,3" FontSize="11.5" Command="{Binding OpenWebCommand}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Status}" Margin="2,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}" FontSize="12" />
            </StackPanel>

            <!-- Results, cheapest first -->
            <Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,8,10,4">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ListingView}">
                                    <!-- One compact line per listing; hover shows the full item -->
                                    <Border x:Name="Card" CornerRadius="6" Background="{StaticResource Panel}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,3" Padding="8,3"
                                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                                            ToolTipService.Placement="Left">
                                        <Border.ToolTip>
                                            <ToolTip Background="{StaticResource Bg}" BorderBrush="{StaticResource BorderStrong}"
                                                     BorderThickness="1" Padding="12,10" MaxWidth="420">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{StaticResource GoldBright}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                                    <ItemsControl ItemsSource="{Binding TopMods}" Margin="0,8,0,0"
                                                                  Visibility="{Binding HasTopMods, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ModLineView}">
                                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Rectangle Height="1" Fill="{StaticResource Border}" Margin="0,6"
                                                               Visibility="{Binding HasTopMods, Converter={StaticResource BoolToVis}}" />
                                                    <ItemsControl ItemsSource="{Binding MainMods}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ModLineView}">
                                                                <WrapPanel Margin="0,0,0,1">
                                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                                                                    <Border CornerRadius="4" Background="#2A2540" Padding="5,0" Margin="6,1,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="{StaticResource ModCrafted}" />
                                                                    </Border>
                                                                </WrapPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="타락" Foreground="{StaticResource Danger}" Margin="0,4,0,0"
                                                               Visibility="{Binding IsCorrupted, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rank}" Foreground="{StaticResource TextFaint}"
                                                       FontSize="11" VerticalAlignment="Center" />
                                            <Image Grid.Column="1" Source="{Binding PriceIcon}" Width="18" Height="18"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding PriceAmount, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Price}" />
                                                <Run Text="{Binding PriceCurrency, Mode=OneWay}" Foreground="{StaticResource Price}" />
                                            </TextBlock>
                                            <!-- Gems: level and quality -->
                                            <TextBlock Grid.Column="3" Text="{Binding GemInfo}" Foreground="{StaticResource Text}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{Binding OnlineColor}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         ToolTip="초록 = 판매자 접속 중" />
                                                <TextBlock Text="{Binding ListedAgo}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelRaised}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="10개 더 보기" HorizontalAlignment="Center" Margin="0,2,0,10" Padding="10,3" FontSize="11.5"
                                Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
